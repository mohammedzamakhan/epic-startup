// Shared build settings for the tenant iOS app.
//
// NOTE: xcconfig treats `//` as a comment start, so URLs are written as plain
// hosts here and `TenantConfiguration.from(infoDictionary:)` adds the scheme.
// `EPIC_*` values are surfaced to Swift through Info.plist substitutions.

EPIC_APP_DISPLAY_NAME = Tenant

// Local development talks to the dev servers over http. Production builds set
// EPIC_USE_TLS = YES and use bare hosts above.
EPIC_USE_TLS = NO

// US control-plane App (published org branding, no customer PII)
EPIC_APP_BASE_URL = localhost:3001

// Regional tenant-api nodes (customer PII lives here)
EPIC_TENANT_API_US_BASE_URL = localhost:3007
EPIC_TENANT_API_KSA_BASE_URL = localhost:3009

// Platform apex whose first subdomain is an org slug
EPIC_BRAND_DOMAIN = epic-startup.test

// Optional white-label binding. Empty = the customer connects their own site.
// For production, set:
//   EPIC_SITE_SLUG = acme
//   EPIC_SITE_ORIGIN = https:/$()/acme.epic-startup.com
EPIC_SITE_SLUG =
EPIC_SITE_HOST =
EPIC_SITE_ORIGIN =
