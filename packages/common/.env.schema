# Shared cookie/session helpers
# See https://varlock.dev/guides/monorepos/
#
# @currentEnv=$NODE_ENV
# @defaultRequired=infer @defaultSensitive=false
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ----------

# @type=enum(production, development, test)
NODE_ENV=development

# Signed cookies (toast, cookie-domain)
# @required @sensitive
SESSION_SECRET="super-duper-s3cret"

# Public app origin for cookie domain inference
# @type=url @sensitive=false
BASE_URL=
