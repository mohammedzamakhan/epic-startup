#!/usr/bin/env bash
# Epic Startup — Amp orb resume.
#
# Runs after activation and on every orb wake. Keep it fast, idempotent, and
# limited to repair work: dependencies and services are handled elsewhere.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

export VOLTA_HOME="${VOLTA_HOME:-$HOME/.volta}"
case ":$PATH:" in *":$VOLTA_HOME/bin:"*) ;; *) export PATH="$VOLTA_HOME/bin:$PATH" ;; esac

# The control-plane SQLite file lives on the orb volume; recreate and seed it if
# a reset removed it. Checked first because setup-hosts.mjs creates an empty
# file when the database is missing.
if [ ! -s packages/database/db/data.db ]; then
	npm run db:migrate:deploy >/dev/null 2>&1 || true
	npm run db:seed >/dev/null 2>&1 || true
fi

# The HTTPS dev proxy (`npm run dev`) resolves brand hostnames from /etc/hosts.
if ! grep -q "app.epic-startup.test" /etc/hosts 2>/dev/null; then
	node scripts/setup-hosts.mjs >/dev/null 2>&1 || true
fi
